# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Resend API Key for sending buyer inquiries securely (Set this in Vercel Environment Variables)
EMAIL_API_KEY="re_your_resend_api_key_here"

# Recipient Email address where all inquiries will be delivered
CONTACT_EMAIL="efanrahman32824@gmail.com"

# Verified Sender Email (Use 'onboarding@resend.dev' during onboarding or your verified domain e.g. 'inquiries@belvoris.com')
FROM_EMAIL="BELVORIS Sourcing <onboarding@resend.dev>"
